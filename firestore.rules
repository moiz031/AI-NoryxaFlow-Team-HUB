rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── OPEN ACCESS FOR ALL COLLECTIONS ────────────────────────────────────
    // The app uses local email/password auth (not Firebase Auth tokens).
    // Firestore is the primary persistence layer for all data.
    // All authenticated reads/writes are allowed so data persists permanently.
    match /{document=**} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Tasks
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Daily Reports
    match /dailyReports/{reportId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Posts (Agency Feed & Community)
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Learning Resources (Academy)
    match /learningResources/{resourceId} {
      allow read, write: if true;
    }

    // Intelligence
    match /intelligence/{itemId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // SOPs
    match /sops/{sopId} {
      allow read, write: if true;
    }

    // File Attachments
    match /files/{fileId} {
      allow read, write: if true;
    }

    // Calendar Events
    match /calendarEvents/{eventId} {
      allow read, write: if true;
    }

    // Global Settings (single doc: 'global')
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
